Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Mission Scene1
      Splitter Ratio: 0.5
    Tree Height: 650
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 0.1
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Mission Scene
      Namespaces:
        drone: true
        drone_arms: true
        executed_trace: true
        floor: true
        planned_route: true
        rotors: true
        target_labels: true
        targets: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /physicalai/markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 30; 42
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.2
      Enable Stereo Rendering:
        Value: false
      Focal Point:
        X: 1.0
        Y: 1.0
        Z: 0.45
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.82
      Target Frame: <Fixed Frame>
      Yaw: 0.78
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  X: 20
  Y: 20
